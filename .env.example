# ---------------------------------------------------------------------------
# Local development environment for krew-hrms.
#
#   make env      generates .env from this file with fresh random secrets
#   (or)          cp .env.example .env  and fill in the two <generate-me> values
#
# See SETUP.md for the full walkthrough. Never commit .env — it is gitignored.
# .env.dist documents every additional variable the project supports
# (GCP storage, LDAP, OAuth, ...).
# ---------------------------------------------------------------------------

DEBUG=True

# python -c 'from django.core.management.utils import get_random_secret_key as g; print(g())'
SECRET_KEY=<generate-me>

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=Asia/Kolkata

# PostgreSQL from docker-compose.dev.yml.
# Use DATABASE_URL, not DB_ENGINE/DB_NAME: the fallback branch in
# horilla/settings/base.py hardcodes a SQLite-only OPTIONS={"timeout": 30}
# that psycopg2 rejects.
DATABASE_URL=postgres://horilla_user:horilla_pass@localhost:5432/krew-dev-db

# Password gate for the in-app "Initialize Database" / demo-data screens.
# python -c 'import secrets; print(secrets.token_hex(24))'
DB_INIT_PASSWORD=<generate-me>

# --- Optional: override docker-compose.dev.yml defaults ---------------------
# LOCAL_DB_PORT=5433          # if host port 5432 is already taken
# PGADMIN_PORT=5050
# PGADMIN_EMAIL=dev@example.com
# PGADMIN_PASSWORD=admin

# Redis — cache only (see docs/redis-and-rls.md). `make dev-db` starts it.
# Leaving this unset is a valid choice: Django falls back to an in-process
# LocMem cache, which is fine for single-process development.
REDIS_URL=redis://localhost:6379/0
# LOCAL_REDIS_PORT=6380       # if host port 6379 is already taken

# --- Recruitment: email + SMS (needed in production) ------------------------
# Email: internal SES HTTP API. When both are set, ALL app email (verification
# links, rejection mails, application links) goes through it instead of the
# SMTP Mail Server configuration. Keep the key in Secrets Manager, not in git.
# SES_API_URL=https://api.greatkapital.in/aws/ses/send-email
# SES_API_KEY=
#
# SMS: MSG91 Flow (DLT template) for the contact-verification OTP. Without
# these, "Verify" on the public application form cannot send the code.
# SMS_PROVIDER=base.sms.msg91
# SMS_API_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_URL=https://control.msg91.com/api/v5
# MSG91_OTP_VARIABLE=var1      # the OTP variable in the template (##var1## -> var1)
# SMS_DEFAULT_COUNTRY_CODE=91  # prefixed to 10-digit numbers

# Local dev only (Google sign-in over http://). Do not set in production.
# OAUTHLIB_INSECURE_TRANSPORT=1
OAUTHLIB_RELAX_TOKEN_SCOPE=1
